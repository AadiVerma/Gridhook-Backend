APP_ENV=development

DATABASE_URL=postgres://localhost:5432/gridhook?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m
DB_CONNECT_TIMEOUT=10s

HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_REQUEST_BYTES=4194304
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

KMS_DATA_KEY=
KMS_KEY_ID=
INTERNAL_TOKEN=

SESSION_TTL=720h

MCP_PUBLIC_BASE_URL=https://gw.gridhook.dev/mcp

UPSTREAM_TIMEOUT=30s
UPSTREAM_MAX_RESPONSE_BYTES=8388608
UPSTREAM_MAX_RETRIES=2
UPSTREAM_MAX_IDLE_CONNS_PER_HOST=16
UPSTREAM_ALLOW_PRIVATE_NETWORKS=true

LOG_LEVEL=info
LOG_FORMAT=text
LOG_COLOR=auto

WORKER_SESSION_SWEEP_INTERVAL=1h
WORKER_SESSION_SWEEP_RETENTION=720h
